# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Puerto del backend
PORT=4000

# PostgreSQL (tabla aspirantes)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orientatec
DB_USER=orientatec
DB_PASSWORD=cambia_esta_contraseña

# MongoDB (historial de conversaciones)
MONGO_URI=mongodb://localhost:27017/orientatec

# URL del servicio de IA (FastAPI)
IA_URL=http://localhost:8000

# Opcional: tiempo máximo (ms) para esperar al servicio de IA. Por defecto 60000.
# IA_TIMEOUT_MS=60000

# Opcional: orígenes permitidos por CORS, separados por coma.
# Si se deja vacío se permite cualquier origen (comportamiento original).
# CORS_ORIGIN=https://orientatec.sarahi-dev.com,http://localhost:3000
