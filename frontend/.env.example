# Copia este archivo como .env.local (ya está ignorado por git).

# URL base del backend. Si se omite se usa /api (mismo dominio, vía nginx).
# VITE_API_URL=http://localhost:4000/api

# Solo para `npm run dev`: a dónde redirige el proxy las llamadas a /api.
# Por defecto apunta a producción; para no mezclar datos de prueba con datos
# reales, apúntalo a tu backend local:
# VITE_PROXY_TARGET=http://localhost:4000
