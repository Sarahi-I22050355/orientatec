# Copia este archivo como .env y llena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Clave de Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_clave_aqui

# Opcional: modelo de Gemini. Por defecto gemini-3.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: segundos máximos de espera a Gemini. Por defecto 45
# GEMINI_TIMEOUT_SEG=45
